local Rules = require("../src/shared/MatchRules")
local Config = require("../src/shared/GameConfig")
local rules = Rules.new(Config.Matches, 0)
assert(rules:begin(10, {1, 2, 3}, "Elimination"))
rules.entries[1].progress, rules.entries[2].progress, rules.entries[3].progress = 500, 200, 300
assert(not rules:capture(29).captured)
local first = rules:capture(30)
assert(first.captured == 2 and not first.winner)
assert(rules.entries[2].status == "Captured")
assert(not rules:capture(49).captured)
local final = rules:capture(50)
assert(final.captured == 3 and final.winner == 1)
assert(rules.entries[1].status == "Finished" and rules.entries[1].progress == 500)
local standings = rules:standings()
assert(standings[1].id == 1 and standings[2].id == 3 and standings[3].id == 2)
assert(rules:tick(50) == "Ended")
local disconnected = Rules.new(Config.Matches, 0)
disconnected:begin(0, {1, 2}, "Elimination")
disconnected:withdraw(2)
assert(disconnected:capture(1).winner == 1, "Disconnection must not leave the last runner waiting")
local tied = Rules.new(Config.Matches, 0)
tied:begin(0, {1, 2, 3}, "Elimination")
assert(tied:capture(20).captured == 3, "Ties must resolve deterministically")
print("Elimination: 20-second captures, standings, winner, disconnects and tie handling passed")
