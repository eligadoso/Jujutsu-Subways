local Config = require("../src/shared/GameConfig")
local Rules = require("../src/shared/MatchRules")
local function close(a, b) assert(math.abs(a - b) < 0.00001) end

assert(Rules.eligible("Lobby", false, true))
assert(not Rules.eligible("Lobby", true, true), "AFK players must not be enrolled")
assert(not Rules.eligible("Solo", false, true), "Solo players must not be enrolled")
assert(not Rules.eligible("Race", false, true), "Participants cannot join another round")
assert(not Rules.eligible("Finished", false, true), "Finishers wait as spectators until the round ends")
assert(not Rules.eligible("Lobby", false, false), "Wait for a living, ready character")

local rules = Rules.new(Config.Matches, 100)
assert(rules.deadline == 110)
assert(rules:tick(109.99) == nil)
assert(rules:tick(110) == "Start")
assert(not rules:begin(110, {}, "Race"), "Empty lobbies must not start races")
assert(rules:begin(110, {11, 22, 33}, "Race"))
assert(rules.deadline == 290 and rules.mode.Distance == 3600)
assert(not rules:begin(111, {44}, "Race"), "Late joiners wait for another round")
close(Rules.crossingTime(3590, 3610, 160, 162, 3600), 161)
assert(Rules.crossingTime(3500, 3550, 160, 162, 3600) == nil)
assert(rules:finish(22, 161))
assert(not rules:finish(22, 162), "Only one result per competitor")
assert(not rules:finish(99, 162), "Only enrolled competitors may finish")
assert(rules:standings()[1].id == 22)
assert(rules:tick(162) == nil, "Other competitors can continue after the first finish")
assert(rules.state == "Race" and rules.deadline == 290, "First finish must not start intermission or change the deadline")
rules:withdraw(33)
rules.entries[33].progress = 3599
rules.entries[11].progress = 500
assert(rules:standings()[2].id == 11, "A withdrawn competitor must not rank ahead of an active runner")
assert(not rules:finish(33, 163))
assert(not rules:finish(11, 290.01), "Reject finishes outside the three-minute limit")
assert(rules:tick(290) == "Ended")
assert(rules.entries[11].status == "TimedOut")
assert(rules.deadline == 300 and rules.state == "Intermission")
assert(rules:tick(299.99) == nil and rules:tick(300) == "Start")

assert(rules:begin(300, {11, 22}, "Race"))
assert(rules:finish(11, 360) and rules:finish(22, 361))
assert(rules:tick(361) == "Ended", "Do not wait three minutes when everyone finishes")
assert(rules.deadline == 371)
assert(rules:begin(371, {11}, "Race"))
rules:withdraw(11)
assert(rules:tick(372) == "Ended", "Leaving/disconnecting must not stall a match")

local tied = Rules.new(Config.Matches, 0)
tied:begin(10, {22, 11}, "Race")
tied:finish(22, 100)
tied:finish(11, 100)
assert(tied:standings()[1].id == 11, "Ties must have a deterministic order")
local mode = Config.Matches.Modes.Race
local full = Rules.new(Config.Matches, 0)
full:begin(10, {1, 2, 3}, "Race")
full:finish(1, 90)
assert(full:tick(90) == nil)
full:finish(2, 100)
assert(full:tick(100) == nil and full.state == "Race")
full:finish(3, 120)
assert(full:tick(120) == "Ended" and full.deadline == 130, "Intermission only starts after the last competitor finishes")
local baseTime = mode.Distance / Config.Speed.Base
assert(baseTime > 120 and baseTime < 150, "Base-speed race should take roughly two minutes")
assert(baseTime + 10 * (Config.Crash.BacktrackDistance / Config.Speed.Base + Config.Crash.PauseDuration) < mode.Duration, "Race should allow several mistakes before timeout")
print("MatchRules: AFK/solo exclusion, 10-second waits, 180-second limit, finishes, rankings, timeouts, withdrawals and race distance passed")
